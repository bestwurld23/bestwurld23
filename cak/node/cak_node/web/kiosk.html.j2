{#
  Kiosk page. AGPL-3.0-or-later (part of node/).

  No JavaScript, on purpose: a shared library terminal with a locked-down
  browser, a 2G tethered phone and a screen reader all get the same page.
  Answers are submitted by POST so a resident's question never lands in the
  URL bar or browser history of a shared machine (PRD §13).

  Accessibility targets: WCAG 2.2 AA, 18px minimum body text (PRD §14).
#}
<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('kiosk.title') }} — {{ pack.name }}</title>
<style>
  :root {
    --bg: #ffffff;
    --ink: #101010;
    --muted: #4a4a4a;
    --accent: #14453f;
    --line: #101010;
    --quote-bg: #f2f2f0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e0f10;
      --ink: #f4f4f2;
      --muted: #c3c3bd;
      --accent: #8fd6c7;
      --line: #f4f4f2;
      --quote-bg: #1a1c1d;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 18px;
    line-height: 1.55;
  }
  .wrap { max-width: 44rem; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
  .banner {
    border: 3px solid var(--line);
    padding: .85rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  h1 { font-size: 1.8rem; line-height: 1.2; margin: 0 0 .35rem; }
  .place { color: var(--muted); margin: 0 0 1.25rem; }
  form { margin: 0 0 1.5rem; }
  label { display: block; font-weight: 700; margin-bottom: .4rem; font-size: 1.1rem; }
  input[type=text] {
    width: 100%;
    font: inherit;
    font-size: 1.15rem;
    padding: .7rem .75rem;
    border: 2px solid var(--line);
    background: var(--bg);
    color: var(--ink);
  }
  button {
    font: inherit;
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: .75rem;
    padding: .7rem 1.4rem;
    border: 2px solid var(--line);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  button:focus-visible, input:focus-visible, a:focus-visible {
    outline: 4px solid var(--accent);
    outline-offset: 2px;
  }
  .answer { border-top: 3px solid var(--line); padding-top: 1.25rem; }
  .answer blockquote {
    margin: .5rem 0;
    padding: .6rem .9rem;
    background: var(--quote-bg);
    border-left: 5px solid var(--accent);
  }
  .citation { border: 2px solid var(--line); padding: .75rem .9rem; margin: .75rem 0; }
  .citation .src { font-weight: 700; }
  .citation .loc { color: var(--muted); font-size: .95rem; }
  .citation .hash { color: var(--muted); font-size: .8rem; word-break: break-all; }
  .office { border: 3px solid var(--line); padding: .9rem 1rem; margin: 1.25rem 0; }
  .office .phone { font-size: 1.6rem; font-weight: 700; }
  .examples li { margin-bottom: .3rem; }
  .foot { color: var(--muted); font-size: .9rem; margin-top: 2rem; }
  .foot a { color: inherit; }
  .skip {
    position: absolute; left: -9999px;
  }
  .skip:focus { position: static; display: inline-block; padding: .5rem; }
</style>
</head>
<body>
<a class="skip" href="#ask">{{ t('kiosk.skip_to_form') }}</a>
<div class="wrap">
  <p class="banner" role="note">{{ pack.legal_banner }}</p>

  <h1>{{ t('kiosk.title') }}</h1>
  <p class="place">{{ pack.name }}</p>

  <form method="post" action="/" id="ask">
    <label for="q">{{ t('kiosk.ask_label') }}</label>
    <input type="text" id="q" name="q" value="" autocomplete="off"
           inputmode="text" maxlength="400"
           placeholder="{{ t('kiosk.ask_placeholder') }}">
    <input type="hidden" name="language" value="{{ language }}">
    <button type="submit">{{ t('kiosk.ask_button') }}</button>
  </form>

  {% if response %}
  <div class="answer" aria-live="polite">
    <h2>{{ t('kiosk.answer_heading') }}</h2>
    {% if response.status == 'ok' %}
      {% for block in answer_blocks %}
        {% if block.kind == 'quote' %}<blockquote>{{ block.text }}</blockquote>
        {% else %}<p>{{ block.text }}</p>{% endif %}
      {% endfor %}
      <h3>{{ t('kiosk.citations_heading') }}</h3>
      {% for citation in response.citations %}
      <div class="citation">
        <div class="src">{{ citation.title }}</div>
        <div class="loc">{{ citation.file_id }} · {{ citation.locator }}</div>
        <p>{{ citation.excerpt }}</p>
        {% if citation.sha256 %}<div class="hash">sha256 {{ citation.sha256 }}</div>{% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p>{{ response.answer_markdown }}</p>
    {% endif %}
  </div>
  {% else %}
  <h2>{{ t('kiosk.examples_heading') }}</h2>
  <ul class="examples">
    {% for example in examples %}<li>{{ example }}</li>{% endfor %}
  </ul>
  {% endif %}

  <div class="office">
    <div>{{ t('kiosk.office_heading') }}</div>
    <div class="src"><strong>{{ pack.authority.name }}</strong></div>
    {% if pack.authority.phone %}<div class="phone">{{ pack.authority.phone }}</div>{% endif %}
    {% if pack.authority.address %}<div>{{ pack.authority.address }}</div>{% endif %}
  </div>

  <p class="foot">
    {{ t('kiosk.pack_label') }}: {{ pack.locale_id }} · {{ pack.pack_version }} ·
    <a href="/print/howto.html">{{ t('kiosk.print_link') }}</a> ·
    <a href="/changelog">{{ t('kiosk.changelog_link') }}</a>
  </p>
</div>
</body>
</html>
